# Build directories
build/
build_release/
build_asan/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# Compiled outputs
*.o
*.a
*.so
*.out
routing_engine_benchmark

# L1 FIX: Never commit compiled LaTeX PDFs.
# pdflatex re-run after every edit creates a new binary diff that bloats
# the git object store permanently. Every recruiter clone downloads full
# PDF history. Build the PDF locally: cd docs && pdflatex write-up.tex (twice).
docs/*.pdf
docs/*.aux
docs/*.log
docs/*.toc
docs/*.out
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk

# GTFS data (large, not source code)
data/
data_*/
raw_*/
*.zip

# Multi-feed study working directory: downloaded archives, unpacked raw feeds,
# the rail-filtered and normalised copies. Several gigabytes, all of it
# regenerable by scripts/fetch_feeds.py.
#
# feeds.lock.json is the ONE exception: it is the checksum of every input a
# published number came from, so it belongs in the repository even though
# everything around it does not. Note the pattern is `feeds/*` and not `feeds/`
# — git does not descend into an excluded DIRECTORY, so a negation inside one
# never fires.
feeds/*
!feeds/feeds.lock.json

# Ridership data fetched by scripts/fetch_ridership.py (with its own lock file).
data-ridership/

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Sanitizer output
*.asan
*.ubsan

# Benchmark and study output (generated — add results/ manually if you want them
# tracked). scripts/reproduce.sh writes all of these.
results/*.txt
results/*.csv
results/*.md
results/*.svg
results/*.log

# Local-only working notes — never publish to the portfolio repo
ANALYSIS.md
WORKFLOW.md
RESUME_PROMPT.md
BIBLE-*.md
WHERE-TO-GO-NEXT.md
